    "input: version-file (.tool-versions | mise.toml)",
    "input: install-hex",
    "input: install-rebar",
    "input: otp-architecture (32 | 64)",
    "input: disable_problem_matchers",
    "input: hexpm-mirrors",
    "input: github-token",
    "output: otp-version",
    "output: elixir-version",
    "output: gleam-version",
    "output: rebar3-version",
    "output: setup-beam-version"
