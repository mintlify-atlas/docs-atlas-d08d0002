  "keyFeatures": [
    "Install Erlang/OTP across Ubuntu, Windows, and macOS runners",
    "Optional installation of Elixir, Gleam, rebar3, hex, and local.rebar",
    "Flexible version matching: strict, loose (semver ranges), and 'latest'",
    "Version file support via .tool-versions (asdf) and mise.toml formats",
    "Problem matchers for Erlang and Elixir compile errors in pull requests",
    "Configurable hex.pm mirrors for resilient dependency fetching",
    "OTP architecture selection (32-bit / 64-bit) on Windows",
    "Environment variables exposing installation directories for NIF builds"
  ],
  "publicApiSurface": [
    "input: otp-version",
